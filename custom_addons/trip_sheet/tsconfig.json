{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "rootDir": "./src/ts",
    "outDir": "./static/src/js",

    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,

    "removeComments": false,
    "sourceMap": true,

    "allowJs": false,

    "lib": [
      "ES2020",
      "DOM"
    ]
  },

  "include": [
    "src/ts/**/*.ts",
    "src/ts/**/*.d.ts"
  ],

  "exclude": [
    "node_modules",
    "static/src/js"
  ]
}