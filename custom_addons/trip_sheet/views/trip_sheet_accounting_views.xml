<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record
        id="view_trip_sheet_form_accounting"
        model="ir.ui.view"
    >
        <field name="name">trip.sheet.form.accounting</field>

        <field name="model">trip.sheet</field>

        <field
            name="inherit_id"
            ref="trip_sheet.view_trip_sheet_form"
        />

        <field name="arch" type="xml">
            <xpath
                expr="//form/sheet"
                position="inside"
            >
                <group string="Accounting">
                    <group>
                        <field name="company_id"/>
                        <field name="accounting_date"/>
                        <field name="fuel_cost"/>
                        <field
                            name="currency_id"
                            invisible="1"
                        />
                    </group>

                    <group>
                        <field name="trip_sheet_journal_id"/>
                        <field name="fuel_account_id"/>
                        <field name="supplier_account_id"/>
                        <field name="expense_account_id"/>
                        <field
                            name="journal_entry_id"
                            invisible="1"
                        />
                    </group>

                    <group>
                        <button
                            name="action_generate_journal_entry"
                            string="Generate Journal Entry"
                            type="object"
                            class="btn-primary"
                            invisible="journal_entry_id"
                        />

                        <button
                            name="action_open_journal_entry"
                            string="Open Journal Entry"
                            type="object"
                            class="btn-secondary"
                            invisible="not journal_entry_id"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>