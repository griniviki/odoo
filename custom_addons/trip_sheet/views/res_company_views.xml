<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_form_trip_sheet" model="ir.ui.view">
        <field name="name">res.company.form.trip.sheet</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Trip Sheet">
                    <group>
                        <field name="trip_sheet_journal_id"/>
                        <field name="trip_fuel_account_id"/>
                        <field name="trip_supplier_account_id"/>
                        <field name="trip_expense_account_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
