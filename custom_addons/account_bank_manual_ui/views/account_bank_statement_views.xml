<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Enable New on the standard Bank Statements list used by
         Dashboard -> Bank -> Transactions -->
    <record id="view_bank_statement_list_enable_create" model="ir.ui.view">
        <field name="name">account.bank.statement.list.enable.create</field>
        <field name="model">account.bank.statement</field>
        <field name="inherit_id" ref="account.view_bank_statement_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">true</attribute>
            </xpath>
        </field>
    </record>

    <!-- Proper form for manual Bank Statement entry -->
    <record id="view_bank_statement_form_manual" model="ir.ui.view">
        <field name="name">account.bank.statement.form.manual</field>
        <field name="model">account.bank.statement</field>
        <field name="arch" type="xml">
            <form string="Bank Statement">
                <sheet>
                    <group>
                        <group>
                            <field name="journal_id"/>
                            <field name="date"/>
                            <field name="name"/>
                            <field name="reference"/>
                        </group>
			<group string="Balance Control">
			   <field name="balance_start" string="Opening Balance"/>
			   <field name="balance_end" string="Calculated Ending Balance" readonly="1"/>
			   <field name="balance_end_real" string="Actual Ending Balance"/>
			   <field name="balance_difference" string="Difference" readonly="1"/>
                    </group>
                    </group>

                    <field name="line_ids">
                        <list editable="bottom" delete="false">
                            <field name="journal_id" column_invisible="1"/>
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="payment_ref"/>
                            <field name="manual_counterpart_account_id"/>
                            <field name="amount"/>
                            <button name="action_remove_manual_transaction"
                                    type="object"
                                    string="Remove"
                                    icon="fa-trash"
                                    confirm="Remove this bank transaction? Its associated accounting entry will also be removed according to Odoo's accounting rules."/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
