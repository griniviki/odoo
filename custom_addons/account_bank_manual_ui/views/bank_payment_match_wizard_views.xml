<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_payment_match_wizard_form" model="ir.ui.view">
        <field name="name">bank.payment.match.wizard.form</field>
        <field name="model">bank.payment.match.wizard</field>
        <field name="arch" type="xml">
        <form string="Match Existing Payment">
        <group>
                <field name="bank_transaction_id"/>
            <field name="partner_id" invisible="1"/>
            <field name="journal_id" invisible="1"/>
            <field name="company_id" invisible="1"/>
            <field name="currency_id" invisible="1"/>
                    <field name="expected_payment_amount" invisible="1"/>
                    <field
                           name="payment_id"
                           domain="[('partner_id', '=', partner_id), ('is_matched', '=', False), ('state', '=', 'in_process'), ('amount', '=', expected_payment_amount), ('payment_type', '=', 'outbound'), ('journal_id', '=', journal_id), ('company_id', '=', company_id), ('currency_id', '=', currency_id)]"
                    />
               </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Match Payment"
                        class="btn-primary"
                    />
                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
