<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!-- 203: Fuel inventory (Ukraine) -->
    <record id="account_203_fuel_ua" model="account.account">
        <field name="code">203</field>
        <field name="name">Паливо</field>
        <field name="account_type">asset_current</field>
        <field name="reconcile" eval="False"/>
        <field name="company_ids" eval="[(6, 0, [ref('l10n_ua_psbo_extension.company_ua')])]"/>
    </record>

    <!-- 631: Domestic suppliers (Ukraine) -->
    <record id="account_631_domestic_suppliers_ua" model="account.account">
        <field name="code">631</field>
        <field name="name">Розрахунки з вітчизняними постачальниками</field>
        <field name="account_type">liability_payable</field>
        <field name="reconcile" eval="True"/>
        <field name="company_ids" eval="[(6, 0, [ref('l10n_ua_psbo_extension.company_ua')])]"/>
    </record>

    <!-- 93: Selling expenses (Ukraine) -->
    <record id="account_93_selling_expenses_ua" model="account.account">
        <field name="code">93</field>
        <field name="name">Витрати на збут</field>
        <field name="account_type">expense</field>
        <field name="reconcile" eval="False"/>
        <field name="company_ids" eval="[(6, 0, [ref('l10n_ua_psbo_extension.company_ua')])]"/>
    </record>

</odoo>
