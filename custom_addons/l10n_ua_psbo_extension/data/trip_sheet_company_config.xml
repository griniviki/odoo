<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!-- Trip Sheet Journal for Ukraine -->
    <record id="trip_sheet_journal_ua" model="account.journal">
        <field name="name">Trip Sheet Journal</field>
        <field name="code">TSJ</field>
        <field name="type">general</field>
        <field name="company_id" ref="l10n_ua_psbo_extension.company_ua"/>
    </record>

    <!-- Link journal and accounts to Ukraine company -->
    <record id="company_ua_trip_sheet_config" model="res.company">
        <field name="id" ref="l10n_ua_psbo_extension.company_ua"/>
        <field name="trip_sheet_journal_id" ref="trip_sheet_journal_ua"/>
        <field name="trip_fuel_account_id" ref="account_203_fuel_ua"/>
        <field name="trip_supplier_account_id" ref="account_631_domestic_suppliers_ua"/>
        <field name="trip_expense_account_id" ref="account_93_selling_expenses_ua"/>
    </record>

</odoo>
