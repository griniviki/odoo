<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record
        id="view_sap_connector_list"
        model="ir.ui.view"
    >
        <field name="name">sap.connector.list</field>
        <field name="model">sap.connector</field>

        <field name="arch" type="xml">
            <list string="SAP Connectors">
                <field name="name"/>
                <field name="company_id"/>
                <field name="base_url"/>
                <field name="last_sync_date"/>
                <field name="last_sync_count"/>
            </list>
        </field>
    </record>

    <record
        id="view_sap_connector_form"
        model="ir.ui.view"
    >
        <field name="name">sap.connector.form</field>
        <field name="model">sap.connector</field>

        <field name="arch" type="xml">
            <form string="SAP Connector">
                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Connection">
                            <field name="company_id"/>
                            <field name="base_url"/>
                        </group>

                        <group string="Synchronization">
                            <field name="last_sync_date"/>
                            <field name="last_sync_count"/>
                        </group>
                    </group>

                    <group>
                        <button
                            name="action_sync_business_partners"
                            string="Sync Business Partners"
                            type="object"
                            class="btn-primary"
                        />
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record
        id="action_sap_connector"
        model="ir.actions.act_window"
    >
        <field name="name">SAP Connectors</field>
        <field name="res_model">sap.connector</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_sap_connector_root"
        name="SAP Connector"
        sequence="50"
    />

    <menuitem
        id="menu_sap_connector"
        name="Configuration"
        parent="menu_sap_connector_root"
        action="action_sap_connector"
        sequence="10"
    />

</odoo>
